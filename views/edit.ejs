<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Driver – F1 Race Tracker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('partials/navbar') %>
<div class="container">
  <h1>Edit Driver</h1>
  <% if (errors.length > 0) { %>
    <div class="errors"><ul>
      <% for (var i = 0; i < errors.length; i++) { %><li><%= errors[i] %></li><% } %>
    </ul></div>
  <% } %>
  <div class="form-card">
    <form method="POST" action="/edit/<%= driver.id %>">
      <div class="form-grid">
        <div class="form-group">
          <label>Driver Name</label>
          <input type="text" name="name" value="<%= driver.name %>">
        </div>
        <div class="form-group">
          <label>Car No.</label>
          <input type="number" name="carNo" value="<%= driver.carNo %>">
        </div>
        <div class="form-group">
          <label>Team</label>
          <input type="text" name="team" value="<%= driver.team %>">
        </div>
        <div class="form-group">
          <label>Points</label>
          <input type="number" name="points" value="<%= driver.points %>">
        </div>
        <div class="form-group">
          <label>Engine Supplier</label>
          <input type="text" name="engine" value="<%= driver.engine %>">
        </div>
        <div class="form-group">
          <label>Race Wins</label>
          <input type="number" name="wins" value="<%= driver.wins %>">
        </div>
        <div class="form-group">
          <label>Nationality</label>
          <input type="text" name="nationality" value="<%= driver.nationality %>">
        </div>
        <div class="form-group">
          <label>Podiums</label>
          <input type="number" name="podiums" value="<%= driver.podiums %>">
        </div>
      </div>
      <div class="form-buttons">
        <button type="submit" class="btn btn-primary">Update Driver</button>
        <a href="/drivers/<%= driver.id %>" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
</body>
</html>