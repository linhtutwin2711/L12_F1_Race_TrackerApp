<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Delete Driver – F1 Race Tracker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('partials/navbar') %>
<div class="container">
  <div class="confirm-card">
    <h2>Delete Driver</h2>
    <p>Are you sure you want to delete:</p>
    <p><strong><%= driver.name %></strong></p>
    <p><%= driver.team %> · Car #<%= driver.carNo %></p>
    <p style="margin-top:8px; color:#c0392b; font-size:0.88rem;">This action cannot be undone.</p>
    <div class="confirm-buttons">
      <form method="POST" action="/delete/<%= driver.id %>">
        <button type="submit" class="btn btn-danger">Confirm</button>
      </form>
      <a href="/drivers/<%= driver.id %>" class="btn btn-secondary">Cancel</a>
    </div>
  </div>
</div>
</body>
</html>