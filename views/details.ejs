<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= driver.name %> – F1 Race Tracker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('partials/navbar') %>
<div class="container">
  <a class="back-link" href="/">‹ Back to Home</a>
  <div class="hero-card">
    <div class="hero-left">
      <h2>#<%= driver.carNo %> &nbsp;<%= driver.name %></h2>
      <p class="sub"><%= driver.team %> &nbsp;·&nbsp; Car #<%= driver.carNo %></p>
    </div>
    <div class="points-box">
      <div class="label">POINTS</div>
      <div class="pts"><%= driver.points %></div>
      <div class="position-label">Position: <strong><%= position %></strong></div>
    </div>
  </div>
  <h2>Driver Details</h2>
  <table class="detail-table">
    <tr><td>Nationality</td><td><%= driver.nationality %></td></tr>
    <tr><td>Team</td><td><%= driver.team %></td></tr>
    <tr><td>Engine Supplier</td><td><%= driver.engine %></td></tr>
    <tr><td>Race Wins</td><td><%= driver.wins %></td></tr>
    <tr><td>Podiums</td><td><%= driver.podiums %></td></tr>
  </table>
  <div class="action-row">
    <a class="btn btn-primary" href="/edit/<%= driver.id %>">Edit Driver</a>
    <a class="btn btn-danger" href="/delete/<%= driver.id %>">Del Driver</a>
  </div>
</div>
</body>
</html>